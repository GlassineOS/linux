# Onyx Boox Note Air: the board's drivers, merged last:
#   make ARCH=arm64 sdm660_defconfig glassine.config onyx-noteair.config
# SoC and PMIC support is in sdm660_defconfig, GlassineOS policy in
# kernel/configs/glassine.config. Board drivers are modules; =y only for what is
# needed before modules can load (the initramfs carries none), each with its reason.

# touch and pen
CONFIG_TOUCHSCREEN_CYTTSP5=m
# frontlight
CONFIG_BACKLIGHT_LM3630A=m
# the e-ink panel's DSI link
CONFIG_DRM_PANEL_ONYX_NA1_LINK=m
# the speaker amplifier
CONFIG_SND_SOC_AW88194=m
