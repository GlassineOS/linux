# Onyx Boox Note Air, merged over sdm660_defconfig:
#   make ARCH=arm64 sdm660_defconfig onyx-noteair.config
# Rule: everything needed to get a log out of a failed boot is built in (=y),
# because the initramfs carries no modules.

CONFIG_LOCALVERSION="-na1"

# Board drivers
CONFIG_TOUCHSCREEN_CYTTSP5=y
CONFIG_BACKLIGHT_LM3630A=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_QCOM_PBS=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_PANIC=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_QCOM_SPMI_RRADC=y
CONFIG_CHARGER_QCOM_SMB2=y
CONFIG_BATTERY_PMI8998_FG=y

# Logs across a reset: ramoops at the stock address (see the DTS)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Hangs must reset the device, not sit there: panic -> reboot (cmdline panic=5),
# lockups -> panic, and the watchdog catches the rest.
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
CONFIG_PANIC_ON_OOPS=y

# USB network console (CDC-NCM gadget)
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y

# initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_OVERLAY_FS=y

# Our own modules must load: MODULE_SIG stays on (defconfig) but not forced
CONFIG_MODULES=y
# CONFIG_MODULE_SIG_FORCE is not set

# Handy while iterating
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK_TIME=y

# e-ink link (msm DPU + DSI 14nm PHY), built in; no fbdev/fbcon: the kernel
# must never draw text into the raw wire frame.
# DRM_MSM=y needs its optional deps built in (or off): they were =m
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_14NM_PHY=y
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
CONFIG_DRM_PANEL_ONYX_NA1_LINK=y
# modules ship uncompressed (busybox/kmod modprobe either way)
# CONFIG_MODULE_COMPRESS is not set
# userdata: Android formats it with the ext4 quota feature (mount -EINVAL without)
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
# audio: the speaker amplifier
CONFIG_SND_SOC_AW88194=m
# Docker: the cgroup cpu controller (docker --cpus / cpu shares); the rest
# Docker needs was already there (namespaces, cgroups, overlayfs, bridge/nat as modules)
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
# GPU for X: vkms = a virtual KMS device for Xorg's modesetting driver;
# Mesa's vkms_dri (kmsro) puts glamor on the Adreno. The real panel stays with
# the e-ink engine on the msm device.
CONFIG_DRM_VKMS=m

# Power / overhead: lazy IOTLB invalidation (strict flushed the IOMMU on every
# DMA unmap: GPU, WiFi, eMMC); no function tracer (a patched hook in every
# kernel function).
# CONFIG_IOMMU_DEFAULT_DMA_STRICT is not set
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y
# CONFIG_FUNCTION_TRACER is not set
# cpuidle: the TEO governor too (switch at runtime via
# cpuidle/current_governor); menu stays the default (rating 20 > 19)
CONFIG_CPU_IDLE_GOV_TEO=y
# RCU callbacks offloaded + lazy (the tick and rcu_preempt are the top idle
# wakeups). RCU_EXPERT only makes NOCB selectable; offload on every CPU
# without a cmdline change. Escape: cmdline rcutree.enable_rcu_lazy=0
CONFIG_RCU_EXPERT=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
CONFIG_RCU_LAZY=y
# userspace wakeup sources (/sys/power/wake_lock): the e-ink engine holds one
# while frames are queued; the power daemon does the wakeup_count handshake
CONFIG_PM_WAKELOCKS=y

# zram: a second compression algorithm for recompressing a parked app's
# slots (zstd) before they are written back compressed
CONFIG_ZRAM_MULTI_COMP=y

# CPRh + OS-programmed OSM cpufreq. Built in: the initramfs has no modules.
CONFIG_QCOM_CPR3=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_ENERGY_MODEL=y
CONFIG_QCOM_SPM=y
# schedutil by default (validated: every OPP stepped by hand under a hash
# load, a 50 ms random-switch storm); powersave/userspace built in for
# pinning a cluster by hand
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# Sleep: the MPM wake controller, parent power domain of the system level in
# sdm636-onyx-noteair-sleep.dtsi
CONFIG_QCOM_MPM=y
