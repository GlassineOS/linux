# GlassineOS: what every GlassineOS kernel has, whatever the SoC. Merged after the
# SoC's defconfig and before the board's fragment:
#   make ARCH=arm64 <soc>_defconfig glassine.config <board>.config

# Hangs reset the device instead of sitting there: a panic reboots (the board's
# command line sets panic=N), lockups and hung tasks panic, and the watchdog,
# already running when the kernel starts, catches the rest
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
CONFIG_PANIC_ON_OOPS=y
CONFIG_LEDS_TRIGGER_PANIC=y

# Logs across a reset (the board's device tree places the ramoops region)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# What the initramfs needs, built in (it carries no modules)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_OVERLAY_FS=y
# userdata formatted by Android has ext4's quota feature, and its mount fails
# without quota support; built in because the initramfs mounts userdata
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y

# USB network console for developer mode (CDC-NCM gadget)
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y

# Modules: ours are unsigned, so signatures are never enforced; shipped
# uncompressed (busybox and kmod modprobe both load them)
CONFIG_MODULES=y
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_COMPRESS is not set

# The display belongs to userspace: no fbdev emulation and no framebuffer
# console, so the kernel never draws text into the panel's frame
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# The configuration inside the kernel (/proc/config.gz), timestamps in the log
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK_TIME=y

# Containers: the cgroup cpu controller (cpu limits and shares)
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y

# CPU frequency: schedutil by default, powersave and userspace built in for
# pinning a cluster by hand; the energy model for energy-aware scheduling
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ENERGY_MODEL=y

# Power and overhead: lazy IOTLB invalidation (strict flushes the IOMMU on every
# DMA unmap); no function tracer (a patched hook in every kernel function)
# CONFIG_IOMMU_DEFAULT_DMA_STRICT is not set
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y
# CONFIG_FUNCTION_TRACER is not set
# cpuidle: the TEO governor too (switch at runtime through
# cpuidle/current_governor); menu stays the default
CONFIG_CPU_IDLE_GOV_TEO=y
# RCU callbacks offloaded and lazy on every CPU, without a command line change
# (RCU_EXPERT only makes NOCB selectable); escape: rcutree.enable_rcu_lazy=0
CONFIG_RCU_EXPERT=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
CONFIG_RCU_LAZY=y
# userspace wakeup sources (/sys/power/wake_lock): the display engine holds one
# while frames are queued; the power daemon does the wakeup_count handshake
CONFIG_PM_WAKELOCKS=y

# zram: a second compression algorithm, to recompress idle pages before writeback
CONFIG_ZRAM_MULTI_COMP=y
